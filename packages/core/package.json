{
  "name": "@thesis-format/core",
  "version": "0.1.0",
  "description": "毕业论文 .docx 格式检查核心库与命令行工具",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "import": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "bin": { "thesis-check": "lib/cli.js" },
  "files": ["lib", "specs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "jszip": "^3.10.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
